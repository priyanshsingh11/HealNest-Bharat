# Copy to .env.local and fill in. Never commit real keys.

# Which data source to use:
#   auto     — Supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, otherwise the in-memory store (default)
#   memory   — always use the in-memory store (settings and demo accounts only; resets on server restart)
#   supabase — always use Supabase (fails loudly if keys are missing)
DATA_SOURCE=auto

# Demo tools: header role switcher (mock login) and "simulate provider update" buttons.
# Set to false before any real deployment.
DEMO_TOOLS=true

# Supabase project settings → API. These are read on the server only.
SUPABASE_URL=
# Legacy "service_role" key or the newer "sb_secret_..." secret key.
# Server-only: this bypasses Row Level Security, so never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Mappls (MapmyIndia) static key for the browser map SDK — it is public by design, so restrict it
# to your domains in the Mappls console. Leave empty to fall back to Leaflet + OpenStreetMap.
NEXT_PUBLIC_MAPPLS_KEY=

# Staff (admin) sign-in. Two steps, and ALL THREE settings below are required — miss any one and staff
# sign-in is switched off entirely rather than falling back to the passcode alone.
#
#   1. The shared passcode. Minimum 8 characters.
ADMIN_PASSCODE=
#   2. Addresses allowed to receive a sign-in code, comma separated. Each one must also exist as a user in
#      Supabase → Authentication → Users, or no code can be sent to it.
ADMIN_EMAILS=
#   3. Supabase project settings → API → the publishable "anon" key, used server-side to send and check the
#      code. Safe to expose by design, but it is read on the server only here.
#      Also: Authentication → Emails → Magic Link template must include {{ .Token }} so the mail carries a
#      code to type, and SMTP must be configured to reach addresses outside your Supabase project members.
SUPABASE_ANON_KEY=
#
# Staff sign in from the small "HealNest staff sign-in" link at the bottom of /login, or directly at /staff.
